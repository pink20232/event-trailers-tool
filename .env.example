# Choose ONE of the following API keys for description suggestions:

# Option 1: OpenAI (ChatGPT) API Key
# Get your API key from: https://platform.openai.com/api-keys
# Sign up for an account and create a new API key
OPENAI_API_KEY=sk-your_openai_api_key_here

# Option 2: Anthropic (Claude) API Key  
# Get your API key from: https://console.anthropic.com/
# Sign up for an account and create an API key in the API Keys section
# ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_api_key_here

# If both are set, OpenAI will be used by default

# Optional: YouTube API Key for more reliable thumbnail access
# YOUTUBE_API_KEY=your_youtube_api_key_here
